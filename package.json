{
  "name": "aero-titanium-aviation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run lint && npm run typecheck && next build",
    "start": "next start",
    "lint": "oxlint . --max-warnings=0",
    "test:contact": "node --test scripts/contact-route.test.mjs",
    "typecheck": "node scripts/clean-route-types.mjs && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.12",
    "next": "^15.5.25",
    "nodemailer": "^10.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "oxlint": "1.87.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "comments": {
    "overrides": "Force transitive deps onto patched versions to clear known advisories (postcss <=8.5.22, sharp <0.35.0) without a breaking Next.js major upgrade."
  },
  "overrides": {
    "postcss": "^8.5.28",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=22.23.3 <23"
  }
}
